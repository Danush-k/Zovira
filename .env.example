# -----------------------------------------------------------------------------
# Zovira environment configuration
# Copy to .env and adjust. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
# Public URL of the web app (used in emails and redirects)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_DB=zovira
POSTGRES_USER=zovira
POSTGRES_PASSWORD=zovira
DATABASE_URL=jdbc:postgresql://localhost:5432/zovira
DATABASE_USERNAME=zovira
DATABASE_PASSWORD=zovira
DATABASE_POOL_SIZE=20

# --- Authentication ----------------------------------------------------------
# REQUIRED in prod. At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ISSUER=zovira
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Refresh-token cookie hardening. Keep COOKIE_SECURE=true anywhere served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# --- Redis (cache + distributed rate limiting) -------------------------------
# When false the API uses an in-process Caffeine cache and in-memory rate limiter.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_ENABLED=true

# --- Object storage ----------------------------------------------------------
# local: files under STORAGE_LOCAL_ROOT served from /media
# s3:    any S3-compatible store (AWS S3, MinIO, Cloudflare R2, ...)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=/media
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=zovira-media
S3_ACCESS_KEY=zovira
S3_SECRET_KEY=zovira-secret
# Public base URL for objects (CDN or bucket URL). Defaults to <endpoint>/<bucket>.
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE_ACCESS=true

# --- Payments ----------------------------------------------------------------
# sandbox:  built-in test gateway (no external calls, clearly labelled in the UI)
# razorpay: live/test Razorpay account using the keys below
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Unpaid online orders are cancelled and stock released after this duration
PENDING_PAYMENT_TIMEOUT=30m

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
# With docker compose, point to Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 SMTP_AUTH=false SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=Zovira <no-reply@zovira.test>

# --- Seed data ---------------------------------------------------------------
# Populates an empty database with demo users, catalog, orders and reviews.
SEED_ENABLED=true

# --- Observability -----------------------------------------------------------
TRACING_SAMPLING_PROBABILITY=0.1
SWAGGER_ENABLED=false

# --- Web app (build time) ----------------------------------------------------
# API origin used by the Vite dev server proxy
VITE_DEV_API_TARGET=http://localhost:8080
